{
  "manifest_version": 3,
  "name": "SpeedDial",
  "short_name": "SpeedDial",
  "version": "2.0.0",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "minimum_chrome_version": "123",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "alarms",
    "bookmarks",
    "contextMenus",
    "favicon",
    "storage"
  ],
  "optional_permissions": [
    "clipboardRead",
    "identity",
    "sessions",
    "tabs",
    "topSites"
  ],
  "optional_host_permissions": [
    "<all_urls>",
    "https://www.bing.com/*",
    "https://suggestqueries.google.com/*",
    "https://api.bing.com/*",
    "https://duckduckgo.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "__MSG_actionTitle__",
    "default_popup": "popup.html"
  }
}
