{
  "manifest_version": 3,
  "name": "SpeedDial",
  "short_name": "SpeedDial",
  "version": "2.0.0",
  "description": "Визуальные закладки на странице новой вкладки",
  "minimum_chrome_version": "123",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "alarms",
    "bookmarks",
    "contextMenus",
    "favicon",
    "identity",
    "storage"
  ],
  "optional_permissions": [
    "clipboardRead"
  ],
  "optional_host_permissions": [
    "<all_urls>",
    "https://www.bing.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Открыть SpeedDial"
  }
}
