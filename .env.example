# Build-time settings. Copy this file to .env.local (it's not committed) and fill in what you need;
# everything is optional — without it the extension builds and works, only the features below are off.

# Client IDs of the registered apps for cloud backups (see docs/cloud-setup.md).
# Without one, the backup settings say that signing in to that service isn't set up in this build.
VITE_GOOGLE_CLIENT_ID=
VITE_DROPBOX_CLIENT_ID=
VITE_ONEDRIVE_CLIENT_ID=

# The "Support the author" page (e.g. on Boosty). Without it the buttons lead to https://boosty.to/
VITE_SUPPORT_URL=
