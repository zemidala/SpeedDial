{
  "name": "speeddial",
  "version": "2.0.0",
  "description": "Visual bookmarks on the new tab page — a Chrome and Edge extension",
  "private": true,
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "vite build",
    "check": "svelte-check && eslint .",
    "test": "vitest run",
    "test:e2e": "vite build && playwright test",
    "icons": "node icon/render.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zemidala/SpeedDial.git"
  },
  "keywords": [
    "browser-extension",
    "chrome-extension",
    "new-tab",
    "speed-dial",
    "bookmarks"
  ],
