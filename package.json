  "license": "GPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "bugs": {
    "url": "https://github.com/zemidala/SpeedDial/issues"
  },
  "homepage": "https://github.com/zemidala/SpeedDial#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/chrome": "^0.3.0",
    "@types/node": "^26.6.2",
    "eslint": "^10.11.0",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.12.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
